{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis.local/schemas/approved_curriculum.schema.json",
  "title": "Approved curriculum bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "courses",
    "max_units_by_semester_index",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump when the contract changes incompatibly."
    },
    "courses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/courseRecord"
      }
    },
    "max_units_by_semester_index": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Index i is global semester i+1 (1-based sem index). Length N defines MAX_SEMESTER = N."
    },
    "metadata": {
      "$ref": "#/$defs/bundleMetadata"
    },
    "prereq_aliases": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/aliasTarget"
      }
    },
    "year_standing_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Standing token -> year level index (solver YEAR_STANDING_RULES semantics)."
    },
    "graduation_trio": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Optional; omit when a program has no trio rule."
    }
  },
  "$defs": {
    "bundleMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_slug",
        "curriculum_version_label",
        "source_pdf_sha256"
      ],
      "properties": {
        "program_slug": {
          "type": "string",
          "minLength": 1
        },
        "curriculum_version_label": {
          "type": "string",
          "minLength": 1
        },
        "source_pdf_sha256": {
          "description": "SHA-256 of source PDF in hex, or null for static/seed exports.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      }
    },
    "reqToken": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "OR-group: at least one alternative must be satisfied."
        }
      ]
    },
    "courseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_title",
        "units",
        "orig_sem",
        "category",
        "year_level",
        "pre-requisites",
        "co-requisites"
      ],
      "properties": {
        "course_title": {
          "type": "string"
        },
        "units": {
          "type": "number",
          "minimum": 0
        },
        "orig_sem": {
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "Rigid",
            "Bottleneck",
            "Flexible"
          ]
        },
        "year_level": {
          "type": "integer",
          "minimum": 1
        },
        "pre-requisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reqToken"
          }
        },
        "co-requisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "aliasTarget": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
